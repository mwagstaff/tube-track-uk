{
  "uid": "tube-track-api-tfl-upstream-api-calls",
  "title": "TfL Upstream API calls",
  "tags": ["tube-track-api", "tfl", "upstream", "api"],
  "timezone": "Europe/London",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "TfL API Calls per Minute",
      "description": "Rolling one-minute TfL request count across the selected dashboard window. TfL limit: 500 requests/minute. Warning lines begin at 350 and 450 requests/minute.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "axisSoftMax": 500,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 350 },
              { "color": "red", "value": 450 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(tube_track_tfl_requests_total{job=\"tube-track-api\"}[1m]))",
          "legendFormat": "TfL calls/min",
          "interval": "1m"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Good Request Rate",
      "gridPos": { "x": 0, "y": 7, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "targets": [{ "expr": "sum(rate(tube_track_tfl_requests_total{job=\"tube-track-api\",status=~\"^[1-3][0-9][0-9]$\"}[$__rate_interval]))", "legendFormat": "good req/sec" }]
    },
    {
      "type": "stat",
      "title": "Bad Request Rate",
      "gridPos": { "x": 4, "y": 7, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "targets": [{ "expr": "sum(rate(tube_track_tfl_requests_total{job=\"tube-track-api\",status=~\"^(timeout|network_error|[4-5][0-9][0-9])$\"}[$__rate_interval])) or vector(0)", "legendFormat": "bad req/sec" }]
    },
    {
      "type": "stat",
      "title": "Error Rate",
      "gridPos": { "x": 8, "y": 7, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "targets": [{ "expr": "100 * (sum(rate(tube_track_tfl_requests_total{job=\"tube-track-api\",status=~\"^(timeout|network_error|[4-5][0-9][0-9])$\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(tube_track_tfl_requests_total{job=\"tube-track-api\",status!=\"cancelled\"}[$__rate_interval])), 1e-9)", "legendFormat": "error %" }]
    },
    {
      "type": "stat",
      "title": "P95 Latency",
      "gridPos": { "x": 12, "y": 7, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(tube_track_tfl_request_duration_seconds_bucket{job=\"tube-track-api\",status!=\"cancelled\"}[$__rate_interval])) by (le))", "legendFormat": "p95" }]
    },
    {
      "type": "stat",
      "title": "Request Queue",
      "description": "TfL calls waiting for an available HTTP concurrency slot.",
      "gridPos": { "x": 16, "y": 7, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "targets": [{ "expr": "sum(tube_track_tfl_request_queue_depth{job=\"tube-track-api\"})", "legendFormat": "queued" }]
    },
    {
      "type": "stat",
      "title": "Live Data Age",
      "description": "Seconds since the most recent successful TfL HTTP response.",
      "gridPos": { "x": 20, "y": 7, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 60 }, { "color": "red", "value": 120 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "targets": [{ "expr": "time() - max(tube_track_tfl_last_success_timestamp_seconds{job=\"tube-track-api\"})", "legendFormat": "request age" }]
    },
    {
      "type": "timeseries",
      "title": "Good Requests (1xx-3xx) - req/sec",
      "gridPos": { "x": 0, "y": 11, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum(rate(tube_track_tfl_requests_total{job=\"tube-track-api\",status=~\"^[1-3][0-9][0-9]$\"}[$__rate_interval])) by (source)", "legendFormat": "{{source}}" }]
    },
    {
      "type": "timeseries",
      "title": "Good Requests by Status - req/sec",
      "gridPos": { "x": 12, "y": 11, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum(rate(tube_track_tfl_requests_total{job=\"tube-track-api\",status=~\"^[1-3][0-9][0-9]$\"}[$__rate_interval])) by (status)", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries",
      "title": "Bad Requests (4xx-5xx + errors) - req/sec",
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum(rate(tube_track_tfl_requests_total{job=\"tube-track-api\",status=~\"^(timeout|network_error|[4-5][0-9][0-9])$\"}[$__rate_interval])) by (source)", "legendFormat": "{{source}}" }]
    },
    {
      "type": "timeseries",
      "title": "Bad Requests by Status - req/sec",
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum(rate(tube_track_tfl_requests_total{job=\"tube-track-api\",status=~\"^(timeout|network_error|[4-5][0-9][0-9])$\"}[$__rate_interval])) by (status)", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries",
      "title": "Timeout Requests - req/sec",
      "description": "Requests aborted by the TubeTrack TfL timeout. These are also included in bad-request panels.",
      "gridPos": { "x": 0, "y": 27, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum(rate(tube_track_tfl_timeouts_total{job=\"tube-track-api\"}[$__rate_interval])) by (source)", "legendFormat": "{{source}}" }]
    },
    {
      "type": "timeseries",
      "title": "Timeout Rate (% of TfL Requests)",
      "gridPos": { "x": 12, "y": 27, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "100 * (sum(rate(tube_track_tfl_timeouts_total{job=\"tube-track-api\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(tube_track_tfl_requests_total{job=\"tube-track-api\",status!=\"cancelled\"}[$__rate_interval])), 1e-9)", "legendFormat": "timeout %" }]
    },
    {
      "type": "table",
      "title": "Top Timeout URLs",
      "description": "Bounded top URL rows from the process rolling six-hour window. Authentication parameters are never recorded.",
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sort_desc(tube_track_tfl_timeout_url_requests{job=\"tube-track-api\"})", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "service_name": true, "Metric": true, "metric": true }, "indexByName": { "url": 0, "source": 1, "status": 2, "Value": 3, "Value #A": 3 }, "renameByName": { "url": "URL", "source": "Source", "status": "Status", "Value": "Timeouts", "Value #A": "Timeouts" } } }]
    },
    {
      "type": "table",
      "title": "Top URLs by Query String and Status",
      "description": "Request counts over the process rolling six-hour window. URLs retain operational query parameters but exclude app_key.",
      "gridPos": { "x": 0, "y": 43, "w": 24, "h": 10 },
      "targets": [{ "refId": "A", "expr": "sort_desc(tube_track_tfl_top_url_requests{job=\"tube-track-api\"})", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "service_name": true, "Metric": true, "metric": true }, "indexByName": { "url": 0, "source": 1, "status": 2, "Value": 3, "Value #A": 3 }, "renameByName": { "url": "URL", "source": "Source", "status": "Status", "Value": "Count", "Value #A": "Count" } } }]
    },
    {
      "type": "timeseries",
      "title": "P95 Latency by TfL Request Source",
      "gridPos": { "x": 0, "y": 53, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(tube_track_tfl_request_duration_seconds_bucket{job=\"tube-track-api\",status!=\"cancelled\"}[$__rate_interval])) by (source, le))", "legendFormat": "{{source}} p95" }]
    },
    {
      "type": "timeseries",
      "title": "Average Latency by TfL Request Source",
      "gridPos": { "x": 12, "y": 53, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum(rate(tube_track_tfl_request_duration_seconds_sum{job=\"tube-track-api\",status!=\"cancelled\"}[$__rate_interval])) by (source) / clamp_min(sum(rate(tube_track_tfl_request_duration_seconds_count{job=\"tube-track-api\",status!=\"cancelled\"}[$__rate_interval])) by (source), 1e-9)", "legendFormat": "{{source}} average" }]
    },
    {
      "type": "table",
      "title": "Slow TfL URLs by P95 Latency",
      "gridPos": { "x": 0, "y": 61, "w": 12, "h": 10 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [{ "matcher": { "id": "byName", "options": "HTTP P95 Latency" }, "properties": [{ "id": "unit", "value": "s" }] }] },
      "targets": [{ "refId": "A", "expr": "sort_desc(tube_track_tfl_slow_url_p95_seconds{job=\"tube-track-api\"})", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "service_name": true, "Metric": true, "metric": true }, "indexByName": { "url": 0, "source": 1, "status": 2, "Value": 3, "Value #A": 3 }, "renameByName": { "url": "URL", "source": "Source", "status": "Status", "Value": "HTTP P95 Latency", "Value #A": "HTTP P95 Latency" } } }]
    },
    {
      "type": "table",
      "title": "Slow TfL URLs by Max Latency",
      "gridPos": { "x": 12, "y": 61, "w": 12, "h": 10 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [{ "matcher": { "id": "byName", "options": "HTTP Max Latency" }, "properties": [{ "id": "unit", "value": "s" }] }, { "matcher": { "id": "byName", "options": "Peak Observed At" }, "properties": [{ "id": "unit", "value": "dateTimeAsIso" }] }] },
      "targets": [
        { "refId": "A", "expr": "sort_desc(tube_track_tfl_slow_url_max_seconds{job=\"tube-track-api\"})", "instant": true, "format": "table" },
        { "refId": "B", "expr": "1000 * tube_track_tfl_slow_url_max_timestamp_seconds{job=\"tube-track-api\"}", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "url", "mode": "outer" } },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "__name__": true, "job": true, "instance": true, "service_name": true, "Metric": true, "metric": true }, "indexByName": { "url": 0, "source": 1, "status": 2, "Value #A": 3, "Value #B": 4, "Value": 3 }, "renameByName": { "url": "URL", "source": "Source", "status": "Status", "Value #A": "HTTP Max Latency", "Value #B": "Peak Observed At", "Value": "HTTP Max Latency" } } }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 Response Payload Size by TfL Request Source",
      "gridPos": { "x": 0, "y": 71, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(tube_track_tfl_response_bytes_bucket{job=\"tube-track-api\"}[$__rate_interval])) by (source, le))", "legendFormat": "{{source}} p95" }]
    },
    {
      "type": "timeseries",
      "title": "Average Response Payload Size by TfL Request Source",
      "gridPos": { "x": 12, "y": 71, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum(rate(tube_track_tfl_response_bytes_sum{job=\"tube-track-api\"}[$__rate_interval])) by (source) / clamp_min(sum(rate(tube_track_tfl_response_bytes_count{job=\"tube-track-api\"}[$__rate_interval])) by (source), 1e-9)", "legendFormat": "{{source}} average" }]
    },
    {
      "type": "table",
      "title": "Largest TfL URLs by P95 Response Payload",
      "gridPos": { "x": 0, "y": 79, "w": 12, "h": 10 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [{ "matcher": { "id": "byName", "options": "P95 Payload" }, "properties": [{ "id": "unit", "value": "bytes" }] }] },
      "targets": [{ "refId": "A", "expr": "sort_desc(tube_track_tfl_large_url_p95_response_bytes{job=\"tube-track-api\"})", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "service_name": true, "Metric": true, "metric": true }, "indexByName": { "url": 0, "source": 1, "status": 2, "Value": 3, "Value #A": 3 }, "renameByName": { "url": "URL", "source": "Source", "status": "Status", "Value": "P95 Payload", "Value #A": "P95 Payload" } } }]
    },
    {
      "type": "table",
      "title": "Largest TfL URLs by Max Response Payload",
      "gridPos": { "x": 12, "y": 79, "w": 12, "h": 10 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [{ "matcher": { "id": "byName", "options": "Max Payload" }, "properties": [{ "id": "unit", "value": "bytes" }] }, { "matcher": { "id": "byName", "options": "Peak Observed At" }, "properties": [{ "id": "unit", "value": "dateTimeAsIso" }] }] },
      "targets": [
        { "refId": "A", "expr": "sort_desc(tube_track_tfl_large_url_max_response_bytes{job=\"tube-track-api\"})", "instant": true, "format": "table" },
        { "refId": "B", "expr": "1000 * tube_track_tfl_large_url_max_response_timestamp_seconds{job=\"tube-track-api\"}", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "url", "mode": "outer" } },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "__name__": true, "job": true, "instance": true, "service_name": true, "Metric": true, "metric": true }, "indexByName": { "url": 0, "source": 1, "status": 2, "Value #A": 3, "Value #B": 4, "Value": 3 }, "renameByName": { "url": "URL", "source": "Source", "status": "Status", "Value #A": "Max Payload", "Value #B": "Peak Observed At", "Value": "Max Payload" } } }
      ]
    }
  ]
}
